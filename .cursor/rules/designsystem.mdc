} 2. Atomes - Exemples de code
Button.jsx - Composant flexible avec variants :​

jsx
import PropTypes from 'prop-types';
import styles from './Button.module.css';

const Button = ({
children,
variant = 'primary',
size = 'md',
disabled = false,
onClick,
...props
}) => {
return (
<button
className={`${styles.button} ${styles[variant]} ${styles[size]}`}
disabled={disabled}
onClick={onClick}
{...props} >
{children}
</button>
);
};

Button.propTypes = {
children: PropTypes.node.isRequired,
variant: PropTypes.oneOf(['primary', 'secondary', 'outline']),
size: PropTypes.oneOf(['sm', 'md', 'lg']),
disabled: PropTypes.bool,
onClick: PropTypes.func
};

export default Button;
Button.module.css - Utiliser les tokens :​

css
.button {
padding: var(--spacing-sm) var(--spacing-md);
border-radius: var(--radius-md);
font-weight: var(--font-weight-bold);
transition: var(--transition-fast);
cursor: pointer;
border: none;
}

.primary {
background: var(--color-primary);
color: white;
}

.secondary {
background: var(--color-secondary);
color: white;
}

.outline {
background: transparent;
border: 2px solid var(--color-primary);
color: var(--color-primary);
}

.sm { font-size: var(--font-size-sm); }
.md { font-size: var(--font-size-md); }
.lg { font-size: var(--font-size-lg); } 3. Molécules - Composition d'atomes
SearchBar.jsx - Combine Input + Button :​

jsx
import { useState } from 'react';
import Input from '../atoms/Input';
import Button from '../atoms/Button';
import Icon from '../atoms/Icon';
import styles from './SearchBar.module.css';

const SearchBar = ({ onSearch, placeholder = "Rechercher..." }) => {
const [value, setValue] = useState('');

const handleSubmit = (e) => {
e.preventDefault();
onSearch(value);
};

return (
<form className={styles.searchBar} onSubmit={handleSubmit}>
<Input
value={value}
onChange={(e) => setValue(e.target.value)}
placeholder={placeholder}
/>
<Button type="submit" variant="primary">
<Icon name="search" />
</Button>
</form>
);
};

export default SearchBar; 4. Organismes - Structures complexes
Header.jsx - Combine plusieurs molécules :​

jsx
import Logo from '../atoms/Logo';
import Navigation from '../molecules/Navigation';
import SearchBar from '../molecules/SearchBar';
import styles from './Header.module.css';

const Header = ({ onSearch, navItems }) => {
return (
<header className={styles.header}>
<Logo />
<Navigation items={navItems} />
<SearchBar onSearch={onSearch} />
</header>
);
};

export default Header; 5. Templates - Layout réutilisable
MainLayout.jsx - Structure de page :​

jsx
import Header from '../organisms/Header';
import Footer from '../organisms/Footer';
import styles from './MainLayout.module.css';

const MainLayout = ({ children, navItems }) => {
return (
<div className={styles.layout}>
<Header navItems={navItems} />
<main className={styles.content}>
{children}
</main>
<Footer />
</div>
);
};

export default MainLayout; 6. Pages - Application finale
